# ============================================================================
# Unified Inbox — Environment Variables Template
# ============================================================================
# Copy to .env (local dev) or .env.production (VPS) and fill in real values.
#
# NEVER commit real secrets to Git.
# Generate JWT_SECRET with: openssl rand -hex 64
# ============================================================================

PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=<generate-with: openssl rand -hex 64>

# CORS — restrict in production, leave empty or * for dev
# CORS_ORIGIN=https://yourdomain.com

# Public origin of this deployment — used to build media URLs that Meta can
# fetch when agents send attachments (falls back to the request host if unset)
# PUBLIC_URL=https://yourdomain.com

# WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com/v24.0
WHATSAPP_PHONE_NUMBER_ID=<your-phone-number-id>
WHATSAPP_ACCESS_TOKEN=<your-whatsapp-token>
WHATSAPP_VERIFY_TOKEN=<your-verify-token>

# Facebook
FACEBOOK_VERIFY_TOKEN=<your-fb-verify-token>
FACEBOOK_APP_ID=<your-app-id>
FACEBOOK_APP_SECRET=<your-app-secret>
FACEBOOK_PAGE_ID=<your-page-id>
FACEBOOK_PAGE_ACCESS_TOKEN=<your-page-token>

# Instagram
INSTAGRAM_ACCESS_TOKEN=<your-ig-token>
INSTAGRAM_ACCOUNT_ID=<your-ig-account-id>

# Email (IMAP for reading, SMTP for sending)
EMAIL_USER=<email@example.com>
EMAIL_PASSWORD=<email-password>
EMAIL_IMAP_HOST=<imap.example.com>
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=<smtp.example.com>
EMAIL_SMTP_PORT=587
EMAIL_FROM_NAME=MedTour Unified Inbox

# ============================================================================
# Better Call Fedi — support help desk ("The Fedi Wire" v1)
# ============================================================================
# Connection string for the SHARED bettercallfedi cluster. Ask Fedi for a
# database user scoped to this project. Backend-only — never expose to the
# client. When unset, the Support page reports itself as unconfigured and
# the rest of the app is unaffected.
# BCF_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Project identity Fedi assigns when he registers the project.
# BCF_PROJECT_KEY=unified-inbox
# BCF_PROJECT_NAME=Unified Inbox
